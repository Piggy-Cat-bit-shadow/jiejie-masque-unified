[Unit]
Description=jiejie-masque CONNECT-IP MASQUE server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=masque-lite
Group=masque-lite
EnvironmentFile=-/etc/jiejie-masque/connect-ip.env
ExecStart=/usr/local/bin/jiejie-masque serve --config /etc/jiejie-masque/connect-ip.yaml
LimitNOFILE=65536
TimeoutStopSec=5s
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
