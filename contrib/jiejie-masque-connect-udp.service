[Unit]
Description=jiejie-masque CONNECT-UDP MASQUE server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=masque
Group=masque
EnvironmentFile=-/etc/jiejie-masque/connect-udp.env
ExecStartPre=/usr/local/bin/jiejie-masque check-config --config /etc/jiejie-masque/connect-udp.yaml
ExecStart=/usr/local/bin/jiejie-masque serve --config /etc/jiejie-masque/connect-udp.yaml
LimitNOFILE=65536
TimeoutStopSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=jiejie-masque-connect-udp
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
