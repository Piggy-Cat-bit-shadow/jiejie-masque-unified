#!/bin/sh
set -eu

config=/etc/jiejie-masque/connect-ip.yaml
external_interface=${MASQUE_EXTERNAL_INTERFACE:-}
external_interface_override=0
masque_bin=${JIEJIE_MASQUE_BIN:-/usr/local/bin/jiejie-masque}

if [ -n "$external_interface" ]; then
	external_interface_override=1
fi

while [ "$#" -gt 0 ]; do
	case "$1" in
		--config) config=$2; shift 2 ;;
		--interface) external_interface=$2; external_interface_override=1; shift 2 ;;
		--binary) masque_bin=$2; shift 2 ;;
		*) echo "usage: $0 [--config PATH] [--interface IFACE] [--binary PATH]" >&2; exit 2 ;;
	esac
done

if [ "$external_interface_override" -eq 0 ]; then
	external_interface=$("$masque_bin" network-prepare-info --config "$config" --field external-interface)
fi
if [ -z "$external_interface" ]; then
	external_interface=$(awk '$2 == "00000000" && $4 != "0" { print $1; exit }' /proc/net/route)
fi
if [ -z "$external_interface" ]; then
	echo "jiejie-masque-connect-ip-network-prepare: external interface not found" >&2
	exit 1
fi

tunnel_ipv4=$("$masque_bin" network-prepare-info --config "$config" --field tunnel-prefix)

nft add table ip masque_lite 2>/dev/null || true
nft flush table ip masque_lite
nft 'add chain ip masque_lite postrouting { type nat hook postrouting priority srcnat; policy accept; }'
nft add rule ip masque_lite postrouting oifname "$external_interface" ip saddr "$tunnel_ipv4" masquerade

if [ "$(cat /proc/sys/net/ipv4/ip_forward)" != "1" ]; then
	printf '%s\n' 1 > /proc/sys/net/ipv4/ip_forward
fi
